# merlin-bot environment variables.
#
# Copy to apps/bot/.env. `make env-check` asserts these keys match
# merlin_bot.config.Settings.model_fields.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# BotFather token. Leave blank locally; the bot logs a warning and exits
# cleanly so you can bring up the rest of the stack without TG.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs for admin-scoped commands (BotCommandScopeChat).
TELEGRAM_ADMIN_CHAT_IDS=
# polling (dev default) or webhook (prod).
TELEGRAM_MODE=polling
# Required only when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_URL=
# TG webhook secret_token; required for production webhook mode.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Merlin API
# ---------------------------------------------------------------------------
MERLIN_API_BASE_URL=http://merlin-api:8000
# MUST match the value in apps/api/.env (and apps/worker/.env if/when it
# starts calling the API).
MERLIN_API_INTERNAL_TOKEN=dev-internal-token-do-not-use-in-prod
MERLIN_API_TIMEOUT_S=10.0

# ---------------------------------------------------------------------------
# Persistence (Redis-backed BasePersistence — different DB index from API)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
