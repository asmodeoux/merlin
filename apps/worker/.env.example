# merlin-worker environment variables.
#
# Copy to apps/worker/.env. `make env-check` asserts these keys match
# merlin_worker.config.Settings.model_fields.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Data plane
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://merlin:merlin@postgres:5432/merlin
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# RQ
# ---------------------------------------------------------------------------
# Comma-separated list of queue names this worker drains.
RQ_QUEUES=default,resolution,reputation
RQ_DEFAULT_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# Resolution-sweep cron (Q-030) — durable backstop for lost RQ jobs.
# Reconciles the durable `claims` table against the RQ queue and
# re-fires bets whose scheduled resolution job was lost from Redis
# (Upstash eviction / worker OOM / Redis restart). Defaults are sane;
# override only to tune cadence or silence the sweep on a dev box.
# ---------------------------------------------------------------------------
RESOLUTION_SWEEP_ENABLED=true
RESOLUTION_SWEEP_INTERVAL_S=900
RESOLUTION_SWEEP_GRACE_S=21600
RESOLUTION_SWEEP_MAX_BATCH=500

# ---------------------------------------------------------------------------
# First-call engagement nudge cron (Q-031). DMs onboarded testers who
# have a name but zero calls, prompting their first bet. Per-user limits
# (once a week, twice ever) are tracked durably in Postgres.
# ---------------------------------------------------------------------------
FIRST_CALL_NUDGE_ENABLED=true
FIRST_CALL_NUDGE_INTERVAL_S=86400
FIRST_CALL_NUDGE_COOLDOWN_S=604800
FIRST_CALL_NUDGE_MAX_SENDS=2
FIRST_CALL_NUDGE_MIN_ACCOUNT_AGE_S=86400

# ---------------------------------------------------------------------------
# External APIs (market data) — CoinGecko-only per Q-026.
# ---------------------------------------------------------------------------
# Demo tier base URL keeps the worker against the free endpoint at v0. When
# we move to a paid plan the same `COINGECKO_API_KEY` variable carries
# forward; only the base URL changes (`https://pro-api.coingecko.com`).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional API key. Leave empty for the anonymous free tier
# (~10–30 calls/min). Set in Fly secrets for staging/prod.
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Telegram (worker sends outbound resolution notifications directly via
# Bot API per the end-to-end plan §5 — not through the bot service).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
