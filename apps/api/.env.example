# merlin-api environment variables.
#
# Copy to apps/api/.env and replace placeholders for local dev. CI uses
# scripts/env_check.py to assert this file's keys match
# merlin_api.config.Settings.model_fields — adding / renaming a var
# requires updating both in the same commit.
#
# Format: KEY=VALUE   # comment describing the var

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=dev                  # dev / staging / prod
LOG_LEVEL=INFO                   # INFO / DEBUG / WARNING / ERROR

# ---------------------------------------------------------------------------
# Data plane
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://merlin:merlin@postgres:5432/merlin
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Auth — HMAC bearer (v0)
# ---------------------------------------------------------------------------
# Bot + worker read the SAME token from their own .env. Rotate via
# `fly secrets set MERLIN_API_INTERNAL_TOKEN=...` on every app together.
MERLIN_API_INTERNAL_TOKEN=dev-internal-token-do-not-use-in-prod

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=                      # leave blank to disable Sentry locally
SENTRY_TRACES_SAMPLE_RATE=0.0    # 0.0–1.0; raise selectively in prod

# ---------------------------------------------------------------------------
# LLM (OpenRouter — freeform claim ingest, Q-028 [PROPOSED])
# ---------------------------------------------------------------------------
# Leave OPENROUTER_API_KEY blank to disable the freeform path entirely.
# The bot then falls back to the button-form flow on every `/alpha`.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Primary: gpt-5-mini — Sprint-1 live calibration showed it ~4.5× cheaper
# per extraction than gemini-3.5-flash (the reasoning-mandatory generation
# inverted the historical Gemini-Flash-is-cheaper picture) AND emits
# better-calibrated confidences (0.90-0.98 vs 0.99-flat) which is exactly
# what our per-field confidence-gating logic depends on.
# Fallback: gemini-3.5-flash — OpenRouter auto-routes to it on primary 5xx.
LLM_PRIMARY_MODEL=openai/gpt-5-mini
LLM_FALLBACK_MODEL=google/gemini-3.5-flash
# Soft monthly USD cap. When exceeded, the API short-circuits freeform
# drafts and the bot falls back to the button form.
LLM_MONTHLY_USD_BUDGET=30.0

# ---------------------------------------------------------------------------
# Market data (CoinGecko — single source per Q-026)
# ---------------------------------------------------------------------------
# Demo tier base URL keeps the API against the free endpoint at v0. When
# we move to a paid plan the same `COINGECKO_API_KEY` variable carries
# forward; only the base URL changes (`https://pro-api.coingecko.com`).
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ---------------------------------------------------------------------------
# Telegram (the worker uses this token directly for outbound notifications;
# the API holds the same value in its Settings shape so env-check passes).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# API metadata (surfaced in OpenAPI)
# ---------------------------------------------------------------------------
API_TITLE=Merlin API
API_VERSION=0.2.0
